# Local-dev var overrides for `wrangler dev` (loaded from the config dir; the
# generated wrangler.dev.jsonc lives here at the repo root too).
#
# API_BASE: the origin the sandboxed agent's Tasks MCP calls back to. In a
# deployed Worker this MUST be set in wrangler.jsonc vars (the workflow's
# prepare step fails the run when it is empty — see ImplementationRun.ts).
# host.docker.internal resolves to the host machine from inside local Docker
# and is allowlisted in Sandbox.ts.
API_BASE=http://host.docker.internal:8787
